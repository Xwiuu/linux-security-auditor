#!/usr/bin/env bash

set -Eeuo pipefail

readonly LSA_VERSION="1.0.0"

SOURCE="${BASH_SOURCE[0]}"

while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done

ROOT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
readonly ROOT_DIR

source "$ROOT_DIR/lib/core.sh"
source "$ROOT_DIR/lib/logger.sh"
source "$ROOT_DIR/lib/utils.sh"
source "$ROOT_DIR/lib/findings.sh"
source "$ROOT_DIR/reporters/text.sh"
source "$ROOT_DIR/reporters/json.sh"
source "$ROOT_DIR/reporters/csv.sh"
source "$ROOT_DIR/modules/host.sh"
source "$ROOT_DIR/modules/users.sh"
source "$ROOT_DIR/modules/sudo.sh"
source "$ROOT_DIR/modules/permissions.sh"
source "$ROOT_DIR/modules/ssh.sh"
source "$ROOT_DIR/modules/ports.sh"
source "$ROOT_DIR/modules/firewall.sh"
source "$ROOT_DIR/modules/processes.sh"
source "$ROOT_DIR/modules/updates.sh"
source "$ROOT_DIR/parsers/journal.sh"
source "$ROOT_DIR/parsers/ssh_auth.sh"
source "$ROOT_DIR/tui/main.sh"

show_version() {
  printf 'Linux Security Auditor %s\n' "$LSA_VERSION"
}

show_help() {
  printf '%s\n' 'Linux Security Auditor'
  printf '\n'
  printf '%s\n' 'Usage:'
  printf '%s\n' '  ./lsa [option]'
  printf '\n'
  printf '%s\n' 'Options:'
  printf '%s\n' '  -h, --help      Show this help message'
  printf '%s\n' '  -v, --version   Show version'
  printf '\n'
  printf '%s\n' 'Commands:'
  printf '%s\n' '  audit                     Run the complete security audit'
  printf '%s\n' '  audit --format text       Render findings as text'
  printf '%s\n' '  audit --format json       Render findings as JSON'
  printf '%s\n' '  audit --format csv        Render findings as CSV'
  printf '%s\n' '  audit --output FILE       Write the report to FILE'
  printf '%s\n' '  tui                       Start interactive terminal interface'
  printf '\n'
  printf '%s\n' 'Examples:'
  printf '%s\n' '  ./lsa audit --format json --output reports/audit.json'
}

run_audit() {
  finding_reset
  reset_firewall_state

  # Users
  audit_uid_zero_users
  audit_interactive_users
  audit_admin_users
  audit_empty_password_users
  audit_locked_users

  # Sudo
  check_sudoers_syntax
  check_sudoers_permissions
  check_sudoers_d_permissions
  check_nopasswd_rules
  check_broad_sudo_rules

  # Critical permissions
  check_file_permissions PERM-001 /etc/passwd 644 root root
  check_shadow_permissions PERM-002 /etc/shadow
  check_file_permissions PERM-003 /etc/group 644 root root
  check_shadow_permissions PERM-004 /etc/gshadow
  check_file_permissions PERM-005 /etc/sudoers 440 root root

  audit_ssh_home_permissions

  # SSH
  check_sshd_available
  check_root_login
  check_password_authentication
  check_empty_passwords
  check_pubkey_authentication
  check_max_auth_tries
  check_x11_forwarding

  # Updates
  check_pending_updates
  check_security_updates

  # Processes
  summarize_root_processes
  check_root_process_executables
  check_root_process_executable_locations

  # Ports
  summarize_listening_ports
  list_exposed_tcp_ports

  # Firewall
  check_firewalld_status
  check_active_zones
  check_active_zone_rules
  check_broad_port_ranges
}

render_audit() {
  local format="$1"

  case "$format" in
    text)
      render_text_findings
      ;;

    json)
      render_json_findings
      ;;

    csv)
      render_csv_findings
      ;;

    *)
      die "unsupported output format: $format"
      ;;
  esac
}

run_audit_command() {
  local format="text"
  local output_file=""

  while (($# > 0)); do
    case "$1" in
      --format)
        if (($# < 2)); then
          die "--format requires a value"
        fi

        format="$2"
        shift 2
        ;;

      --output)
        if (($# < 2)); then
          die "--output requires a file path"
        fi

        output_file="$2"
        shift 2
        ;;

      *)
        die "unknown audit option: $1"
        ;;
    esac
  done

  case "$format" in
    text | json | csv)
      ;;
    *)
      die "unsupported output format: $format"
      ;;
  esac

  run_audit

  if [[ -z "$output_file" ]]; then
    render_audit "$format"
    return 0
  fi

  local output_dir
  output_dir="$(dirname "$output_file")"

  if [[ ! -d "$output_dir" ]]; then
    die "output directory does not exist: $output_dir"
  fi

  case "$format" in
    text)
      write_text_report "$output_file"
      ;;
    json)
      write_json_report "$output_file"
      ;;
    csv)
      write_csv_report "$output_file"
      ;;
  esac
}

main() {
  case "${1:-}" in
    -h | --help)
      show_help
      ;;
    -v | --version)
      show_version
      ;;
    audit)
      shift
      run_audit_command "$@"
      ;;
    tui)
      tui_main_menu
      ;;
    host)
      printf 'Hostname: %s\n' "$(get_hostname)"
      printf 'Kernel: %s\n' "$(get_kernel)"
      printf 'Architecture: %s\n' "$(get_architecture)"
      printf 'OS: %s\n' "$(get_os_name)"
      printf 'Version: %s\n' "$(get_os_version)"
      printf 'Init: %s\n' "$(get_init_system)"
      printf 'Package Manager: %s\n' "$(get_package_manager)"
      printf 'Uptime: %s\n' "$(get_uptime)"
      ;;
    users)
      audit_uid_zero_users
      audit_interactive_users
      audit_admin_users
      audit_empty_password_users
      audit_locked_users
      ;;
    sudo)
      check_sudoers_syntax
      check_sudoers_permissions
      check_sudoers_d_permissions
      check_nopasswd_rules
      check_broad_sudo_rules
      ;;
    permissions)
      check_file_permissions PERM-001 /etc/passwd 644 root root
      check_shadow_permissions PERM-002 /etc/shadow
      check_file_permissions PERM-003 /etc/group 644 root root
      check_shadow_permissions PERM-004 /etc/gshadow
      check_file_permissions PERM-005 /etc/sudoers 440 root root

      audit_ssh_home_permissions
      ;;
    ssh)
      check_sshd_available
      check_root_login
      check_password_authentication
      check_empty_passwords
      check_pubkey_authentication
      check_max_auth_tries
      check_x11_forwarding
      findings_summary
      ;;
    ports)
      summarize_listening_ports
      list_exposed_tcp_ports
      ;;
    firewall)
      detect_firewall_backend
      check_firewalld_status
      check_active_zones
      check_active_zone_rules
      check_broad_port_ranges
      ;;
    processes)
      summarize_root_processes
      check_root_process_executables
      check_root_process_executable_locations
      ;;
    updates)
      check_pending_updates
      check_security_updates
      ;;
    journal)
      read_auth_journal
      ;;
    sshlog)
      parse_ssh_auth_events
      ;;
    *)
      show_banner
      ;;
  esac
}
main "$@"
