#!/usr/bin/env bash

set -Eeuo pipefail

readonly LSA_VERSION="0.1.0"

readonly ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "$ROOT_DIR/lib/core.sh"
source "$ROOT_DIR/lib/logger.sh"
source "$ROOT_DIR/lib/utils.sh"
source "$ROOT_DIR/modules/host.sh"
source "$ROOT_DIR/modules/users.sh"
source "$ROOT_DIR/modules/sudo.sh"
source "$ROOT_DIR/modules/permissions.sh"
source "$ROOT_DIR/modules/ssh.sh"
source "$ROOT_DIR/modules/ports.sh"

show_version() {
printf 'Linux Security Auditor %s\n' "$LSA_VERSION"
}

show_help() {
    printf '%s\n' 'Linux Security Auditor'
    printf '\n'
    printf '%s\n' 'Usage:'
    printf '%s\n' '  ./lsa [option]'
    printf '\n'
    printf '%s\n' 'Options:'
    printf '%s\n' '  -h, --help      Show this help message'
    print '%s\n'  '  -v, --version   Show version'
}



main() {
  case "${1:-}" in
    -h|--help)
      show_help
      ;;
    -v|--version)
      show_version
      ;;
    host)
      printf 'Hostname: %s\n' "$(get_hostname)"
      printf 'Kernel: %s\n' "$(get_kernel)"
      printf 'Architecture: %s\n' "$(get_architecture)"
      printf 'OS: %s\n' "$(get_os_name)"
      printf 'Version: %s\n' "$(get_os_version)"
      printf 'Init: %s\n' "$(get_init_system)"
      printf 'Package Manager: %s\n' "$(get_package_manager)"
      printf 'Uptime: %s\n' "$(get_uptime)"
      ;;
    users)
      audit_uid_zero_users
      audit_interactive_users
      audit_admin_users
      audit_empty_password_users
      audit_locked_users
      ;;
    sudo)
      check_sudoers_syntax
      check_sudoers_permissions
      check_sudoers_d_permissions
      check_nopasswd_rules
      check_broad_sudo_rules
      ;;
    permissions)
      check_file_permissions /etc/passwd 644 root root
      check_shadow_permissions /etc/shadow
      check_file_permissions /etc/group 644 root root
      check_shadow_permissions /etc/gshadow
      check_file_permissions /etc/sudoers 440 root root

      target_home="$(get_target_home)"
      check_ssh_directory_permissions "$target_home"
      check_authorized_keys_permissions "$target_home"
      ;;
    ssh)
      check_sshd_available
      check_root_login
      check_password_authentication
      check_empty_passwords
      check_pubkey_authentication
      check_max_auth_tries
      check_x11_forwarding
      ;;
    ports)
      summarize_listening_ports
      list_exposed_tcp_ports
      ;;
    *)
      show_banner
      ;;
    esac
}
main "$@"
